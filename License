
---

## ⚙️ 2. `CMakeLists.txt`

```cmake
cmake_minimum_required(VERSION 3.15)
project(ZucksAntiCheat VERSION 1.0.0 LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

if(WIN32)
    add_definitions(-D_WIN32_WINNT=0x0601)
    set(PLATFORM_LIBS ws2_32 winhttp)
else()
    set(PLATFORM_LIBS pthread dl)
endif()

find_package(Threads REQUIRED)

file(GLOB ZUCKS_SOURCES
    "src/core/*.cpp"
    "src/network/*.cpp"
    "src/anticheat/*.cpp"
    "src/admin/*.cpp"
    "src/utils/*.cpp"
)

add_executable(ZucksAntiCheat ${ZUCKS_SOURCES})

target_include_directories(ZucksAntiCheat PRIVATE src)

# Optional: SQLite (vendored)
if(EXISTS "${CMAKE_SOURCE_DIR}/third_party/sqlite3.c")
    target_sources(ZucksAntiCheat PRIVATE third_party/sqlite3.c)
    target_include_directories(ZucksAntiCheat PRIVATE third_party)
endif()

target_link_libraries(ZucksAntiCheat PRIVATE Threads::Threads ${PLATFORM_LIBS})

if(UNIX)
    target_link_libraries(ZucksAntiCheat PRIVATE sqlite3)
endif()

install(TARGETS ZucksAntiCheat RUNTIME DESTINATION bin)
install(DIRECTORY web/ DESTINATION share/zucks/web)
install(DIRECTORY config/ DESTINATION share/zucks/config)